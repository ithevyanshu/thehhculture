# --- Database (Neon / Supabase) ---
# Pooled connection string (used by the app at runtime).
# Neon "-pooler" hosts support prepared statements: do NOT add `pgbouncer=true`
# (it makes Prisma use ~5 round trips per query). Only add it for poolers that
# reject prepared statements (e.g. older PgBouncer / Supabase port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dhh?sslmode=require"
# Direct (non-pooled) connection string (used by Prisma migrations).
# If your provider gives you only one URL, use the same value for both.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dhh?sslmode=require"

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# --- Seed: initial admin account (used by `npm run db:seed`) ---
ADMIN_EMAIL=admin@dhh.local
ADMIN_PASSWORD=change-me-admin-password

# Optional demo listener for local development, so the personalized home has data.
# Leave this blank to skip it; it is never created when NODE_ENV=production.
DEMO_PASSWORD=
